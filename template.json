{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Capstone image resizer with private S3 buckets, Pillow layer, Step Functions and an IAM-authorized HTTP API.",
  "Parameters": {
    "AssetsBucket": {
      "Type": "String",
      "Description": "Same-region private bucket containing the two deployment ZIP files."
    }
  },
  "Resources": {
    "Thumbnails": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "${AWS::StackName}-thumbnails-${AWS::AccountId}-${AWS::Region}"
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        }
      }
    },
    "LambdaRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": {
                  "Fn::Sub": "lambda.${AWS::URLSuffix}"
                }
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "CapstoneAccess",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "s3:GetObject",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${AWS::StackName}-originals-${AWS::AccountId}-${AWS::Region}/originals/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "s3:ListBucket",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${AWS::StackName}-originals-${AWS::AccountId}-${AWS::Region}"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "s3:PutObject",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${AWS::StackName}-thumbnails-${AWS::AccountId}-${AWS::Region}/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/${AWS::StackName}-resize:*"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "ResizeLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${AWS::StackName}-resize"
        },
        "RetentionInDays": 7
      }
    },
    "PillowLayer": {
      "Type": "AWS::Lambda::LayerVersion",
      "Properties": {
        "LayerName": {
          "Fn::Sub": "${AWS::StackName}-pillow"
        },
        "CompatibleRuntimes": [
          "python3.12"
        ],
        "CompatibleArchitectures": [
          "x86_64"
        ],
        "Content": {
          "S3Bucket": {
            "Ref": "AssetsBucket"
          },
          "S3Key": "pillow-layer.zip"
        }
      }
    },
    "Resize": {
      "Type": "AWS::Lambda::Function",
      "DependsOn": "ResizeLogs",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-resize"
        },
        "Handler": "lambda_function.lambda_handler",
        "Runtime": "python3.12",
        "Architectures": [
          "x86_64"
        ],
        "Role": {
          "Fn::GetAtt": [
            "LambdaRole",
            "Arn"
          ]
        },
        "MemorySize": 512,
        "Timeout": 30,
        "Layers": [
          {
            "Ref": "PillowLayer"
          }
        ],
        "Code": {
          "S3Bucket": {
            "Ref": "AssetsBucket"
          },
          "S3Key": "resize-code.zip"
        },
        "Environment": {
          "Variables": {
            "ORIGINALS_BUCKET": {
              "Fn::Sub": "${AWS::StackName}-originals-${AWS::AccountId}-${AWS::Region}"
            },
            "THUMBNAILS_BUCKET": {
              "Ref": "Thumbnails"
            }
          }
        }
      }
    },
    "S3InvokePermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Fn::GetAtt": [
            "Resize",
            "Arn"
          ]
        },
        "Principal": {
          "Fn::Sub": "s3.${AWS::URLSuffix}"
        },
        "SourceAccount": {
          "Ref": "AWS::AccountId"
        },
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:s3:::${AWS::StackName}-originals-${AWS::AccountId}-${AWS::Region}"
        }
      }
    },
    "Originals": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "${AWS::StackName}-originals-${AWS::AccountId}-${AWS::Region}"
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "NotificationConfiguration": {
          "LambdaConfigurations": [
            {
              "Event": "s3:ObjectCreated:*",
              "Function": {
                "Fn::GetAtt": [
                  "Resize",
                  "Arn"
                ]
              },
              "Filter": {
                "S3Key": {
                  "Rules": [
                    {
                      "Name": "prefix",
                      "Value": "originals/"
                    }
                  ]
                }
              }
            }
          ]
        }
      },
      "DependsOn": "S3InvokePermission"
    },
    "WorkflowRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": {
                  "Fn::Sub": "states.${AWS::URLSuffix}"
                }
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "CapstoneAccess",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "lambda:InvokeFunction",
                  "Resource": {
                    "Fn::GetAtt": [
                      "Resize",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "Workflow": {
      "Type": "AWS::StepFunctions::StateMachine",
      "Properties": {
        "StateMachineName": {
          "Fn::Sub": "${AWS::StackName}-workflow"
        },
        "StateMachineType": "STANDARD",
        "RoleArn": {
          "Fn::GetAtt": [
            "WorkflowRole",
            "Arn"
          ]
        },
        "DefinitionS3Location": {
          "Bucket": {
            "Ref": "AssetsBucket"
          },
          "Key": "state-machine.asl.json"
        },
        "DefinitionSubstitutions": {
          "ResizeFunctionArn": {
            "Fn::GetAtt": [
              "Resize",
              "Arn"
            ]
          }
        }
      }
    },
    "ApiRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": {
                  "Fn::Sub": "apigateway.${AWS::URLSuffix}"
                }
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "CapstoneAccess",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "states:StartExecution",
                  "Resource": {
                    "Ref": "Workflow"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "Api": {
      "Type": "AWS::ApiGatewayV2::Api",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-api"
        },
        "ProtocolType": "HTTP"
      }
    },
    "Integration": {
      "Type": "AWS::ApiGatewayV2::Integration",
      "Properties": {
        "ApiId": {
          "Ref": "Api"
        },
        "IntegrationType": "AWS_PROXY",
        "IntegrationSubtype": "StepFunctions-StartExecution",
        "PayloadFormatVersion": "1.0",
        "CredentialsArn": {
          "Fn::GetAtt": [
            "ApiRole",
            "Arn"
          ]
        },
        "RequestParameters": {
          "StateMachineArn": {
            "Ref": "Workflow"
          },
          "Input": "$request.body"
        }
      }
    },
    "Route": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "Api"
        },
        "RouteKey": "POST /resize",
        "AuthorizationType": "AWS_IAM",
        "Target": {
          "Fn::Sub": "integrations/${Integration}"
        }
      }
    },
    "Stage": {
      "Type": "AWS::ApiGatewayV2::Stage",
      "DependsOn": "Route",
      "Properties": {
        "ApiId": {
          "Ref": "Api"
        },
        "StageName": "$default",
        "AutoDeploy": true,
        "DefaultRouteSettings": {
          "ThrottlingBurstLimit": 2,
          "ThrottlingRateLimit": 1
        }
      }
    }
  },
  "Outputs": {
    "OriginalsBucket": {
      "Value": {
        "Ref": "Originals"
      }
    },
    "ThumbnailsBucket": {
      "Value": {
        "Ref": "Thumbnails"
      }
    },
    "WorkflowArn": {
      "Value": {
        "Ref": "Workflow"
      }
    },
    "ResizeApiUrl": {
      "Value": {
        "Fn::Sub": "${Api.ApiEndpoint}/resize"
      }
    },
    "ResizeFunction": {
      "Value": {
        "Ref": "Resize"
      }
    }
  }
}
