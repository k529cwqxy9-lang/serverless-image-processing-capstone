{
  "StartAt": "ResizeImage",
  "States": {
    "ResizeImage": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {"FunctionName": "${ResizeFunctionArn}", "Payload.$": "$"},
      "OutputPath": "$.Payload",
      "Catch": [{"ErrorEquals": ["States.ALL"], "Next": "ResizeFailed"}],
      "Next": "WasResizeSuccessful"
    },
    "WasResizeSuccessful": {
      "Type": "Choice",
      "Choices": [{"Variable": "$.success", "BooleanEquals": true, "Next": "ThumbnailCreated"}],
      "Default": "ResizeFailed"
    },
    "ThumbnailCreated": {"Type": "Succeed"},
    "ResizeFailed": {"Type": "Fail", "Error": "ResizeFailed", "Cause": "The thumbnail could not be created. Check the preceding state output."}
  }
}
